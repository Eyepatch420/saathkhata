<?xml version="1.0" encoding="utf-8"?>
<!--
  The API is served over plain HTTP from a bare IP address, and Android 9+
  blocks cleartext traffic by default. Allow it for the hosts we actually use
  and nothing else.

  This file must stay referenced from AndroidManifest.xml
  (android:networkSecurityConfig="@xml/network_security_config"), otherwise it
  is dead weight and cleartext stays blocked.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- Deployed backend — ApiEndpoints.baseUrl default -->
        <domain includeSubdomains="false">45.195.159.30</domain>

        <!-- Local backend from the Android emulator (host loopback alias) -->
        <domain includeSubdomains="false">10.0.2.2</domain>

        <!-- Local backend from a physical device on the same Wi-Fi -->
        <domain includeSubdomains="false">192.168.0.107</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
