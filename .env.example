# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored; never commit real keys.
#
# SECURITY: anything in `.env` is bundled into the built app and can be
# extracted from the APK/IPA. Only publishable keys belong here. SMS/OTP provider
# credentials (UDO) are server-side only and must NEVER be added to this file —
# the app talks to the backend's /auth/otp/* endpoints instead.

# ─── LocationIQ (map tiles / geocoding) ──────────────────────────────────────
LOCATIONIQ_API_KEY=

